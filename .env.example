# Copy to .env and fill in before running docker compose up.

# Full base URL of the API — used by the Next.js dashboard (baked in at build time).
# Local dev:       API_BASE=http://localhost:8000
# With Nginx+SSL:  API_BASE=https://api.sentinel.yourdomain.com
API_BASE=http://localhost:8000

# Database credentials
DB_USER=sentinel
DB_PASSWORD=sentinel
DB_NAME=sentinel
